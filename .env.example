# Abetworks Hub — env contract
#
# Every name here is read by code under app/, lib/ or components/. Leave a
# name commented out to fall back to that module's default.

# ─── origins ───────────────────────────────────────────────────────────
# SITE_URL — this deployment's own origin. Used for og:image and metadata.
# HUB_URL  — where the hub is hosted; canonical tags point here so a fork
#            page and its hub twin do not compete as duplicates. Both
#            blank defaults are https://hub.abetworks.in.
# SITE_URL=https://hub.abetworks.in
# HUB_URL=https://hub.abetworks.in

# ─── AI key (Abetworks-hosted) ─────────────────────────────────────────
# Preferred path. Point at a self-hosted or Abetworks-fronted inference
# endpoint. Without these, every tool falls back to a deterministic engine.
# ABET_API_KEY=
# ABET_API_BASE=
# ABET_MODEL=

# ─── AI key (OpenAI-compatible) ────────────────────────────────────────
# Alternative path. Any OpenAI-compatible endpoint works (OpenAI, Groq,
# Together, a local llama.cpp server, etc.).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
